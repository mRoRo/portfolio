---
import type { Lang } from '../config';
import profile from '../content/profile.json';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const yearsExperience = new Date().getFullYear() - profile.careerStartYear;

const skillColors: Record<string, string> = {
  languages: '',
  frameworks: 'skill-tag-purple',
  libraries: 'skill-tag-green',
  tools: '',
  ai: 'skill-tag-amber',
  architecture: 'skill-tag-purple',
  other: 'skill-tag-green',
};
---

<!-- ═══════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════ -->
<section id="hero" class="min-h-screen flex items-center px-8 py-16 lg:py-0">
  <div class="w-full max-w-5xl mx-auto">

    <!-- Badge -->
    <div class="animate-fade-in-up delay-100 mb-6">
      <span class="inline-flex items-center gap-2 font-mono text-xs py-1.5 px-4 rounded-full"
            style="background: var(--bg-green-08); border: 1px solid var(--border-green-30); color: var(--green-bright);">
        <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: var(--green-pure);"></span>
        {profile.badge[lang]}
      </span>
    </div>

    <!-- Main hero grid: Identity | Stats Panel -->
    <div class="grid lg:grid-cols-[1fr_320px] gap-8 items-start">

      <!-- Identity -->
      <div>
        <!-- Avatar with animated conic-gradient glow -->
        <div class="animate-fade-in-up delay-100 mb-5">
          <div class="relative inline-block">
            <!-- Rotating conic-gradient ring -->
            <div class="absolute -inset-[3px] rounded-full avatar-glow-ring" aria-hidden="true"></div>
            <img
              src="/avatar.jpg"
              alt="María Rodríguez Rojo"
              width="96"
              height="96"
              class="relative rounded-full object-cover"
              style="width: 96px; height: 96px;"
            />
          </div>
        </div>

        <!-- Prompt line -->
        <div class="animate-fade-in-up delay-200 font-mono text-sm mb-3" style="color: var(--cyan-soft);">
          <span style="color: var(--green-pure);">❯</span> whoami
        </div>

        <!-- Glitch name -->
        <h1
          class="glitch animate-fade-in-up delay-200 font-display font-bold leading-none mb-4"
          aria-label={profile.name}
          data-text={profile.name}
          style="font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.03em; color: var(--text-bright);"
        >
          {profile.name}
        </h1>

        <!-- Title with neon glow -->
        <div class="animate-fade-in-up delay-300 font-display font-medium mb-2"
             style="font-size: clamp(1.1rem, 2.5vw, 1.5rem); color: var(--cyan);">
          {profile.headline[lang]}
        </div>

        <!-- Subheadline -->
        <div class="animate-fade-in-up delay-400 font-mono text-sm mb-6" style="color: var(--text-muted);">
          // {profile.subheadline[lang]}
        </div>

        <!-- Description -->
        <p class="animate-fade-in-up delay-500 font-sans text-base leading-relaxed mb-8 max-w-xl"
           style="color: var(--text-body);">
          {profile.heroDescription[lang]}
        </p>

        <!-- CTAs -->
        <div class="animate-fade-in-up delay-600 flex flex-wrap gap-4">
          <a
            href="#contact"
            class="cta-btn-cyan inline-flex items-center gap-2 py-3 px-6 rounded-md font-display font-medium text-sm transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"/></svg> {t('hero.cta.contact')}
          </a>
          <a
            href="#projects"
            class="cta-btn-purple inline-flex items-center gap-2 py-3 px-6 rounded-md font-display font-medium text-sm transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg> {t('hero.cta.projects')}
          </a>
        </div>
      </div>

      <!-- Stats Terminal Panel -->
      <div class="animate-fade-in-up delay-400 terminal-window self-start">
        <div class="terminal-bar">
          <span>{t('hero.status')}</span>
        </div>
        <div class="terminal-content py-5 px-5">
          <div class="space-y-4">
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-xs" style="color: var(--cyan-soft);">$</span>
              <div>
                <div class="font-mono text-2xl font-semibold" style="color: var(--cyan); line-height:1;">{yearsExperience}+</div>
                <div class="font-mono text-xs mt-0.5" style="color: var(--text-muted);">{t('hero.stat.experience')}</div>
              </div>
            </div>

            <div class="h-px" style="background: rgba(0,212,255,0.08);"></div>

            <div class="flex items-baseline gap-2">
              <span class="font-mono text-xs" style="color: var(--cyan-soft);">$</span>
              <div>
                <div class="font-mono text-2xl font-semibold" style="color: var(--green-pure); line-height:1;">6+</div>
                <div class="font-mono text-xs mt-0.5" style="color: var(--text-muted);">{t('hero.stat.projects')}</div>
              </div>
            </div>

            <div class="h-px" style="background: rgba(0,212,255,0.08);"></div>

            <div class="flex items-baseline gap-2">
              <span class="font-mono text-xs" style="color: var(--cyan-soft);">$</span>
              <div>
                <div class="font-mono text-sm font-semibold" style="color: var(--text-bright); line-height:1.4;">{profile.location[lang]}</div>
                <div class="font-mono text-xs mt-0.5" style="color: var(--text-muted);">{t('hero.stat.location')}</div>
              </div>
            </div>

            <div class="h-px" style="background: rgba(0,212,255,0.08);"></div>

            <!-- Tech stack pills -->
            <div>
              <div class="font-mono text-xs mb-2" style="color: var(--cyan-dim);">stack</div>
              <div class="flex flex-wrap gap-1.5">
                {['Swift', 'SwiftUI', 'UIKit', 'MVVM'].map(s => (
                  <span class="skill-tag text-[10px] py-0.5 px-2">{s}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Location indicator -->
    <div class="animate-fade-in-up delay-700 mt-10 flex items-center gap-2 font-mono text-xs"
         style="color: var(--text-dim);">
      <svg class="w-3 h-3 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--cyan-dim);"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
      {profile.location[lang]}
      <span class="mx-2" style="color: rgba(0,212,255,0.2);">|</span>
      <a href={`mailto:${profile.email}`} style="color: var(--cyan-soft);" class="hover:text-[var(--cyan)] transition-colors">{profile.email}</a>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     ABOUT
     ═══════════════════════════════════════════════════════════ -->
<section id="about" class="px-8 py-20">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-mono text-sm mb-8" style="color: var(--cyan-soft);">
      <span aria-hidden="true" style="color: var(--cyan);">❯</span> {t('about.label')}
    </h2>

    <div class="grid lg:grid-cols-[1fr_280px] gap-8">

      <!-- Bio terminal panel -->
      <div class="terminal-window animate-fade-in-up">
        <div class="terminal-bar"><span>~/bio.md</span></div>
        <div class="terminal-content">
          <p class="font-sans text-base leading-loose" style="color: var(--text-body);">
            {profile.bio[lang]}
          </p>

          <!-- Hobbies -->
          <div class="mt-6">
            <div class="font-mono text-xs mb-3" style="color: var(--cyan-dim);">// interests_offline</div>
            <div class="flex flex-wrap gap-2">
              {profile.hobbies[lang].map((h) => (
                <span class="font-mono text-xs py-1 px-3 rounded-full"
                      style="background: rgba(191,0,255,0.05); border: 1px solid rgba(191,0,255,0.2); color: rgba(191,0,255,0.8);">
                  {h}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Side panels -->
      <div class="space-y-4">

        <!-- Education -->
        <div class="terminal-window animate-fade-in-up delay-200">
          <div class="terminal-bar"><span>{t('about.education')}</span></div>
          <div class="terminal-content py-4">
            {profile.education.map((edu) => (
              <div class="mb-4 last:mb-0">
                <div class="font-display font-medium text-sm" style="color: var(--text-bright);">{edu.degree[lang]}</div>
                <div class="font-mono text-xs mt-1" style="color: var(--cyan-mid);">{edu.school}</div>
                <div class="font-mono text-xs" style="color: var(--text-dim);">{edu.year}</div>
                {edu.note && <div class="font-mono text-xs mt-1 italic" style="color: var(--text-dim);">{edu.note[lang]}</div>}
              </div>
            ))}
          </div>
        </div>

        <!-- Certs -->
        <div class="terminal-window animate-fade-in-up delay-300">
          <div class="terminal-bar"><span>{t('about.certifications')}</span></div>
          <div class="terminal-content py-4">
            {profile.certifications.map((cert) => (
              <div class="flex items-start gap-2 mb-3 last:mb-0">
                <span class="font-mono text-[10px] mt-0.5" style="color: var(--cyan-dim);">✓</span>
                <div>
                  <div class="font-mono text-xs font-medium" style="color: var(--text-bright);">{cert.name}</div>
                  <div class="font-mono text-[10px]" style="color: var(--text-dim);">{cert.issuer}{cert.year ? ` · ${cert.year}` : ''}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Languages -->
        <div class="terminal-window animate-fade-in-up delay-400">
          <div class="terminal-bar"><span>{t('about.languages')}</span></div>
          <div class="terminal-content py-4">
            {profile.languages.map((l) => (
              <div class="flex items-center justify-between mb-2 last:mb-0">
                <span class="font-mono text-xs" style="color: var(--text-bright);">{l.name[lang]}</span>
                <span class="font-mono text-xs" style="color: var(--cyan-mid);">{l.level[lang]}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     EXPERIENCE
     ═══════════════════════════════════════════════════════════ -->
<section id="experience" class="px-8 py-20">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-mono text-sm mb-8" style="color: var(--cyan-soft);">
      <span aria-hidden="true" style="color: var(--cyan);">❯</span> {t('experience.label')}
    </h2>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px hidden md:block"
           style="background: linear-gradient(to bottom, rgba(0,212,255,0.5), rgba(191,0,255,0.2), transparent);"></div>

      <div class="space-y-6">
        {profile.experience.map((exp, i) => (
          <div class={`animate-fade-in-up delay-${(i + 1) * 100} relative md:pl-10`}>
            <!-- Timeline dot -->
            <div class="absolute left-0 top-5 w-[15px] h-[15px] rounded-full hidden md:flex items-center justify-center"
                 style="background: var(--color-surface-dark); border: 2px solid var(--cyan-soft);">
              <div class="w-1.5 h-1.5 rounded-full" style="background: var(--cyan);"></div>
            </div>

            <div class="terminal-window">
              <div class="terminal-bar">
                <span style="flex: 1;">{exp.company}</span>
                <span style="color: var(--text-dim); font-size: 0.65rem;">{exp.period}</span>
              </div>
              <div class="terminal-content">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <h3 class="font-display font-semibold text-base" style="color: var(--text-bright);">{exp.role[lang]}</h3>
                    <div class="font-mono text-xs mt-0.5" style="color: var(--cyan-mid);">{exp.duration[lang]}</div>
                  </div>
                  {exp.current && (
                    <span class="font-mono text-[10px] py-1 px-2 rounded flex-shrink-0"
                          style="background: var(--bg-green-08); border: 1px solid var(--border-green-30); color: var(--green-pure);">
                      {t('experience.current')}
                    </span>
                  )}
                </div>

                <p class="font-sans text-sm leading-relaxed mb-4" style="color: var(--text-body);">
                  {exp.description[lang]}
                </p>

                <div>
                  <div class="font-mono text-[10px] mb-2" style="color: var(--cyan-dim);">// {t('experience.stack')}</div>
                  <div class="flex flex-wrap gap-1.5">
                    {exp.tags.map((tag) => (
                      <span class="skill-tag py-0.5 px-2 text-[10px]">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     PROJECTS
     ═══════════════════════════════════════════════════════════ -->
<section id="projects" class="px-8 py-20">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-mono text-sm mb-8" style="color: var(--cyan-soft);">
      <span aria-hidden="true" style="color: var(--cyan);">❯</span> {t('projects.label')}
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {profile.projects.map((proj, i) => {
        const link = (proj as any).link as {en: string; es: string} | undefined;
        const cardContent = (
          <>
            <div class="terminal-bar" style={proj.highlight ? "border-bottom-color: rgba(0,212,255,0.3)" : ""}>
              <span style="flex: 1;"><span class="sr-only">{t('projects.label')} — </span>{proj.name}</span>
              {proj.highlight && (
                <span class="font-mono text-[9px]" style="color: var(--green-bright);">★</span>
              )}
              {link && (
                <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--cyan-soft);">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              )}
            </div>
            <div class="terminal-content">
              <div class="font-mono text-[10px] mb-2" style="color: var(--text-dim);">{proj.company} · {proj.period}</div>
              <p class="font-sans text-sm leading-relaxed mb-3" style="color: var(--text-body);">{proj.description[lang]}</p>
              <div class="flex flex-wrap gap-1">
                {proj.skills.map((s) => (
                  <span class="skill-tag py-0.5 px-1.5 text-[9px]">{s}</span>
                ))}
              </div>
            </div>
          </>
        );
        if (link) {
          return (
            <a
              href={link[lang]}
              target="_blank"
              rel="noopener noreferrer"
              class={`animate-fade-in-up delay-${(i + 1) * 100} terminal-window group ${proj.highlight ? 'ring-1 ring-[rgba(0,212,255,0.2)]' : ''}`}
              aria-label={`${proj.name} — ${t('projects.reference')}`}
            >
              {cardContent}
            </a>
          );
        }
        return (
          <div class={`animate-fade-in-up delay-${(i + 1) * 100} terminal-window group cursor-default ${proj.highlight ? 'ring-1 ring-[rgba(0,212,255,0.2)]' : ''}`}>
            {cardContent}
          </div>
        );
      })}
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     SKILLS
     ═══════════════════════════════════════════════════════════ -->
<section id="skills" class="px-8 py-20">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-mono text-sm mb-8" style="color: var(--cyan-soft);">
      <span aria-hidden="true" style="color: var(--cyan);">❯</span> {t('skills.label')}
    </h2>

    <div class="terminal-window">
      <div class="terminal-bar"><span>skills --verbose</span></div>
      <div class="terminal-content">
        <div class="space-y-6">

          {Object.entries(profile.skills).map(([category, items], i) => (
            <div class={`animate-fade-in-up delay-${(i + 1) * 100}`}>
              <div class="font-mono text-xs mb-3 flex items-center gap-2"
                   style="color: var(--cyan-soft);">
                <span style="color: rgba(0,212,255,0.3);">//</span>
                {t(('skills.' + category) as any)}
              </div>
              <div class="flex flex-wrap gap-2">
                {(items as string[]).map((skill) => (
                  <span class={`skill-tag ${skillColors[category] || ''}`}>{skill}</span>
                ))}
              </div>
              {i < Object.keys(profile.skills).length - 1 && (
                <div class="mt-6" style="height: 1px; background: rgba(0,212,255,0.05);"></div>
              )}
            </div>
          ))}

        </div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     CONTACT
     ═══════════════════════════════════════════════════════════ -->
<section id="contact" class="px-8 py-20">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-mono text-sm mb-8" style="color: var(--cyan-soft);">
      <span aria-hidden="true" style="color: var(--cyan);">❯</span> {t('contact.label')}
    </h2>

    <div class="terminal-window max-w-2xl">
      <div class="terminal-bar"><span>./init_contact.sh</span></div>
      <div class="terminal-content">

        <!-- Available status -->
        <div class="flex items-center gap-3 mb-6 p-3 rounded-md"
             style="background: var(--bg-green-08); border: 1px solid var(--border-green-15);">
          <span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: var(--green-pure);"></span>
          <span class="font-mono text-sm" style="color: var(--green-bright);">{t('contact.available')}</span>
        </div>

        <!-- Contact links -->
        <div class="space-y-3">

          <!-- Email — with copy button -->
          <div class="contact-link group flex items-center gap-3 p-3 rounded-md transition-all duration-200">
            <!-- Email SVG icon -->
            <svg class="w-4 h-4 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--cyan-soft);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${profile.email}`} class="font-mono text-sm font-medium min-w-0 truncate flex-1" style="color: var(--cyan);">{profile.email}</a>
            <!-- Copy button -->
            <button
              data-copy={profile.email}
              aria-label={lang === 'en' ? 'Copy email address' : 'Copiar dirección de email'}
              class="copy-btn flex-shrink-0 w-8 h-8 flex items-center justify-center rounded transition-all duration-200 opacity-0 group-hover:opacity-100"
              style="color: var(--cyan-soft); border: 1px solid var(--border-cyan-10);"
            >
              <svg class="copy-icon w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
              </svg>
              <svg class="check-icon w-3.5 h-3.5 hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="color: var(--green-pure);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </button>
          </div>

          <!-- LinkedIn -->
          <a href={profile.linkedin} target="_blank" rel="noopener"
             class="contact-link group flex items-center gap-3 p-3 rounded-md transition-all duration-200"
          >
            <svg class="w-4 h-4 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" style="color: var(--cyan-soft);">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
