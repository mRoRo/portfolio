---
import { ClientRouter } from 'astro:transitions';
import { siteConfig, type Lang } from '../config';
import profile from '../content/profile.json';

// Replace {yearsExperience} placeholder in profile text
const yearsExp = new Date().getFullYear() - profile.careerStartYear;
const yr = (s: string) => s.replace(/{yearsExperience}/g, String(yearsExp));
import { useTranslations } from '../i18n/translations';
import '../styles/global.css';

const { siteUrl } = siteConfig;

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  detectBrowserLang?: boolean;
}

const { lang, title, description, detectBrowserLang = false } = Astro.props;
const t = useTranslations(lang);

const otherLang = lang === siteConfig.defaultLang ? siteConfig.secondaryLang : siteConfig.defaultLang;
const otherLangUrl = lang === siteConfig.defaultLang ? `/${siteConfig.secondaryLang}/` : '/';
const otherLangLabel = otherLang.toUpperCase();


const pageTitle = title || `${profile.name} — ${profile.headline[lang]}`;
const pageDescription = description || profile.heroDescription[lang];
const canonicalUrl = lang === siteConfig.defaultLang ? siteUrl : `${siteUrl}/${lang}/`;
const ogImage = `${siteUrl}/avatar.jpg`;
---

<!DOCTYPE html>
<html lang={lang} class="dark" data-career-start={String(profile.careerStartYear)}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="author" content={profile.name} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:site_name" content={profile.name} />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@MariaRRojo" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": profile.name,
    "jobTitle": profile.headline[lang],
    "description": pageDescription,
    "url": canonicalUrl,
    "email": profile.email,
    "address": { "@type": "PostalAddress", "addressLocality": "Valladolid", "addressCountry": "ES" },
    "sameAs": [profile.linkedin, profile.github.url, "https://twitter.com/MariaRRojo"],
    "knowsAbout": ["iOS Development", "Swift", "SwiftUI", "UIKit", "Mobile Development"],
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "Universidad de Valladolid" }
  })} />

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Non-blocking font load: preload + print/onload swap trick -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" /></noscript>
  <ClientRouter />

  <!-- No-flash theme init -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const isDark = saved ? saved === 'dark' : true;
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.classList.toggle('light', !isDark);
    })();
  </script>

  <!-- Browser language auto-detection -->
  {detectBrowserLang && (
    <script is:inline>
      (function() {
        if (sessionStorage.getItem('langDetected')) return;
        sessionStorage.setItem('langDetected', '1');
        const lang = (navigator.language || navigator.languages?.[0] || '').toLowerCase();
        if (lang.startsWith('es')) {
          window.location.replace('/es/');
        }
      })();
    </script>
  )}
</head>

<body id="top" class="min-h-screen antialiased">
  <!-- Skip to content — keyboard accessibility -->
  <a
    href="#hero"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[999] focus:px-4 focus:py-2 focus:rounded-md focus:font-mono focus:text-xs"
    style="background: var(--color-surface-dark); border: 1px solid var(--border-cyan-40); color: var(--cyan);"
  >
    Skip to content
  </a>

  <!-- ═══════════════════════════════════════════
       SIDEBAR — Desktop
       ═══════════════════════════════════════════ -->
  <aside class="sidebar-desktop fixed left-0 top-0 h-screen w-[260px] flex flex-col z-50"
         style="background: var(--color-surface-dark); border-right: 1px solid rgba(0,212,255,0.12);">

    <!-- Logo / Identity -->
    <div class="p-6 pb-4" style="border-bottom: 1px solid rgba(0,212,255,0.08);">
      <a href="#hero" class="block group">
        <div class="font-display font-semibold text-lg leading-tight group-hover:text-[#00d4ff] transition-colors duration-200"
             style="letter-spacing: -0.02em; color: var(--text-bright);">
          mRoRo
        </div>
        <div class="font-mono text-xs mt-1" style="color: var(--cyan-mid);">
          {profile.headline[lang]}
        </div>
      </a>
    </div>

    <!-- Online badge -->
    <div class="px-6 py-3 flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full" style="background: var(--green-pure);"></span>
      <span class="font-mono text-xs" style="color: var(--green-mid);">{profile.badge[lang]}</span>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-4 py-2 overflow-y-auto" aria-label={t('nav.section.navigate')}>
      <div class="font-mono text-xs mb-3 px-3" style="color: rgba(0,212,255,0.7); letter-spacing: 0.08em;">{t('nav.section.navigate')}</div>
      <a href="#about" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
        {t('nav.about')}
      </a>
      <a href="#experience" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.073a2.25 2.25 0 01-2.25 2.25h-12a2.25 2.25 0 01-2.25-2.25V6.75A2.25 2.25 0 016 4.5h5.25M20.25 14.15l-5.625-5.625M20.25 14.15L14.625 8.525m0 0l-4.875 4.875M8.25 12l1.5 1.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 7.5h6M9 10.5h3"/></svg>
        {t('nav.experience')}
      </a>
      <a href="#projects" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
        {t('nav.projects')}
      </a>
      <a href="#skills" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .23 2.717-1.189 2.717H4.986c-1.419 0-2.186-1.719-1.189-2.717L5 14.5"/></svg>
        {t('nav.skills')}
      </a>
      <a href="#testimonials" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
        Recommendations
      </a>
      <a href="#contact" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"/></svg>
        {t('nav.contact')}
      </a>

      <div class="font-mono text-xs mt-6 mb-3 px-3" style="color: rgba(0,212,255,0.7); letter-spacing: 0.08em;">{t('nav.section.connect')}</div>
      <a href={profile.github.url} target="_blank" rel="noopener" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        GitHub
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a href={`https://twitter.com/MariaRRojo`} target="_blank" rel="noopener" class="sidebar-link mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </a>
    </nav>

    <!-- Controls: Theme + Lang -->
    <div class="p-4" style="border-top: 1px solid rgba(0,212,255,0.08);">
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Switch to light mode"
          class="flex-1 flex items-center justify-center gap-2 py-2 px-3 rounded-md font-mono text-xs transition-all duration-200"
          style="background: var(--bg-cyan-05); border: 1px solid var(--border-cyan-15); color: var(--cyan-mid);"
        >
          <span class="theme-btn-icon" aria-hidden="true"><svg class="theme-sun" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.59M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg><svg class="theme-moon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg></span>
          <span class="theme-to-light">Light</span>
          <span class="theme-to-dark">Dark</span>
        </button>

        <!-- Lang Toggle -->
        <a
          href={otherLangUrl}
          class="flex items-center justify-center py-2 px-3 rounded-md font-mono text-xs font-semibold transition-all duration-200"
          style="background: rgba(191,0,255,0.05); border: 1px solid rgba(191,0,255,0.15); color: #cc55ff; min-width: 44px;"
        >
          {otherLangLabel}
        </a>
      </div>
    </div>

  </aside>

  <!-- ═══════════════════════════════════════════
       MOBILE UTILITY PILL (theme + lang) — top-right
       ═══════════════════════════════════════════ -->
  <div class="mobile-util-pill md:hidden" aria-label="Utility controls">
    <button
      id="theme-toggle-mobile"
      class="mobile-util-btn"
      aria-label="Switch to light mode"
      style="background: none; border: none; cursor: pointer;"
    >
      <span class="theme-btn-icon" aria-hidden="true"><svg class="theme-sun w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.59M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg><svg class="theme-moon w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg></span>
    </button>
    <a href={otherLangUrl} class="mobile-util-btn" style="color: #cc55ff;">
      <span class="font-mono text-[11px] font-semibold">{otherLangLabel}</span>
    </a>
  </div>

  <!-- ═══════════════════════════════════════════
       MOBILE BOTTOM NAV — section links only
       ═══════════════════════════════════════════ -->
  <nav class="mobile-nav fixed bottom-0 left-0 right-0 z-50 flex items-center justify-around"
       aria-label={t('nav.section.navigate')}
       style="background: var(--color-surface-dark); border-top: 1px solid rgba(0,212,255,0.12);">
    <a href="#about" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label={t('nav.about')}>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
    </a>
    <a href="#experience" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label={t('nav.experience')}>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.073a2.25 2.25 0 01-2.25 2.25h-12a2.25 2.25 0 01-2.25-2.25V6.75A2.25 2.25 0 016 4.5h5.25M20.25 14.15l-5.625-5.625M20.25 14.15L14.625 8.525m0 0l-4.875 4.875M8.25 12l1.5 1.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 7.5h6M9 10.5h3"/></svg>
    </a>
    <a href="#projects" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label={t('nav.projects')}>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
    </a>
    <a href="#skills" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label={t('nav.skills')}>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .23 2.717-1.189 2.717H4.986c-1.419 0-2.186-1.719-1.189-2.717L5 14.5"/></svg>
    </a>
    <a href="#testimonials" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label="Recommendations">
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
    </a>
    <a href="#contact" class="mobile-nav-item" style="color: rgba(0,212,255,0.6);" aria-label={t('nav.contact')}>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"/></svg>
    </a>
  </nav>

    <!-- ═══════════════════════════════════════════
       SCANLINES OVERLAY
       ═══════════════════════════════════════════ -->
  <div class="scanlines fixed inset-0 z-[1] pointer-events-none opacity-40"></div>

  <!-- ═══════════════════════════════════════════
       MAIN CONTENT
       ═══════════════════════════════════════════ -->
  <main class="main-content min-h-screen">
    <slot />
  </main>

  <script>
    // Wrap everything in initTheme() and call via astro:page-load
    // This fires on BOTH initial load AND every View Transition navigation.
    // Without this, module scripts only run once — listeners die after nav.
    function initTheme() {
      // ── 1. Restore theme from localStorage immediately ──────────────────
      const saved = localStorage.getItem('theme');
      const shouldBeDark = saved !== 'light';
      document.documentElement.classList.toggle('dark', shouldBeDark);
      document.documentElement.classList.toggle('light', !shouldBeDark);

      // ── 2. Kill stale listeners from previous run ───────────────────────
      const _win = window as typeof window & { __themeAbort?: AbortController };
      _win.__themeAbort?.abort();
      const _ctrl = new AbortController();
      _win.__themeAbort = _ctrl;
      const _sig = _ctrl.signal;

      // ── 3. Wire up theme toggle buttons ────────────────────────────────
      // Visual state (icon crossfade + label) is handled entirely by CSS
      // (html.dark / html.light classes). JS only updates aria-label.
      const btn = document.getElementById('theme-toggle');
      const bm  = document.getElementById('theme-toggle-mobile');

      function applyTheme(dark: boolean) {
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.toggle('light', !dark);
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        // aria-label describes the ACTION (what clicking will do)
        const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
        if (btn) btn.setAttribute('aria-label', label);
        if (bm)  bm.setAttribute('aria-label', label);
      }

      const isDark = document.documentElement.classList.contains('dark');
      const initLabel = isDark ? 'Switch to light mode' : 'Switch to dark mode';
      if (btn) btn.setAttribute('aria-label', initLabel);
      if (bm)  bm.setAttribute('aria-label', initLabel);

      btn?.addEventListener('click', () => {
        applyTheme(!document.documentElement.classList.contains('dark'));
      }, { signal: _sig });

      bm?.addEventListener('click', () => {
        applyTheme(!document.documentElement.classList.contains('dark'));
      }, { signal: _sig });

      // ── 4. Active nav link on scroll ────────────────────────────────────
      const sections    = document.querySelectorAll('section[id]');
      const sidebarLinks = document.querySelectorAll('.sidebar-link');
      const navObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              sidebarLinks.forEach(link => {
                link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
              });
            }
          });
        },
        { threshold: 0.3 }
      );
      sections.forEach(s => navObserver.observe(s));

      // ── 5. Pause glitch animation when off-screen ────────────────────────
      const glitchEl = document.querySelector('.glitch');
      if (glitchEl) {
        const glitchObserver = new IntersectionObserver(
          ([entry]) => {
            (glitchEl as HTMLElement).style.animationPlayState =
              entry.isIntersecting ? 'running' : 'paused';
          },
          { threshold: 0 }
        );
        glitchObserver.observe(glitchEl);
      }

      // ── 6. Years of experience — runtime recalc (stays correct without rebuild)
      (function updateYears() {
        const startYear = parseInt(
          document.documentElement.dataset.careerStart ?? '2013', 10
        );
        const years = new Date().getFullYear() - startYear;

        // Stat panel number
        const stat = document.getElementById('years-exp-stat');
        if (stat) stat.textContent = String(years);

        // Hero inline text spans: replace the build-time digit with runtime value
        ['years-exp-sub', 'years-exp-desc'].forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          // data-years-tpl holds the build-time rendered text
          const src = el.getAttribute('data-years-tpl') ?? el.textContent ?? '';
          el.textContent = src.replace(/\d+(\+ years?|\+ años| years?| años)/, years + '$1');
        });
      })();

      // ── 7. Copy email button ─────────────────────────────────────────────
      document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(copyBtn => {
        copyBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          const text = copyBtn.dataset.copy ?? '';
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const copyIcon  = copyBtn.querySelector<SVGElement>('.copy-icon');
            const checkIcon = copyBtn.querySelector<SVGElement>('.check-icon');
            if (copyIcon && checkIcon) {
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              setTimeout(() => {
                checkIcon.classList.add('hidden');
                copyIcon.classList.remove('hidden');
              }, 2000);
            }
          } catch { /* clipboard unavailable */ }
        }, { signal: _sig });
      });
    }

    // astro:page-load fires on initial load AND after every View Transition
    document.addEventListener('astro:page-load', initTheme);
  </script>

</body>
</html>
